---
const target = `${import.meta.env.BASE_URL}en/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<meta name="robots" content="noindex" />
		<title>TypeRB Contributor Guide</title>
		<script is:inline define:vars={{ target }}>window.location.replace(target);</script>
	</head>
	<body>
		<p><a href={target}>Open the English guide</a></p>
	</body>
</html>
