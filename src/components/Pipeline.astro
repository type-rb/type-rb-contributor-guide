---
interface Props {
	label: string;
	stages: string[];
}

const { label, stages } = Astro.props;
---

<ol class="pipeline" aria-label={label}>
	{stages.map((stage, index) => (
		<li>
			<span class="pipeline-number" aria-hidden="true">{index + 1}</span>
			<span>{stage}</span>
		</li>
	))}
</ol>

<style>
	.pipeline {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 0.8rem;
		margin: 1.5rem 0 2rem;
		padding: 0;
		list-style: none;
	}

	.pipeline li {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-height: 4.5rem;
		padding: 0.9rem;
		border: 1px solid color-mix(in srgb, var(--trb-map) 38%, var(--sl-color-gray-5));
		border-radius: 0.8rem;
		background: color-mix(in srgb, var(--sl-color-black) 94%, var(--sl-color-accent-low));
		font-weight: 650;
		line-height: 1.35;
	}

	.pipeline-number {
		display: grid;
		flex: 0 0 1.8rem;
		width: 1.8rem;
		height: 1.8rem;
		place-items: center;
		border-radius: 999px;
		background: var(--trb-map);
		color: var(--sl-color-black);
		font-size: 0.8rem;
		font-weight: 800;
	}

	@media (min-width: 50rem) {
		.pipeline li:not(:last-child)::after {
			content: '›';
			position: absolute;
			right: -0.62rem;
			z-index: 1;
			color: var(--trb-caution);
			font-size: 1.4rem;
			font-weight: 800;
		}
	}
</style>
